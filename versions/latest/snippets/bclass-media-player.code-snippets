{
  "Sound Player Settings (JS)": {
    "prefix": "soundPlayerSettings",
    "body": [
      "const soundPlayerSettings = {",
      "\tHoverLoad: ${1|true,false|}, // Play on mouse hover",
      "\tSkipTime: ${2:5}, // Time (seconds) for forward/rewind",
      "\tSubTitleApi: \"${3:/api/subtitle/}\" // Subtitle API path",
      "};"
    ],
    "description": "Audio player configuration object"
  },
  "Simple Audio Player (HTML)": {
    "prefix": [
      "sound-player-simple",
      "sound-player-html"
    ],
    "body": [
      "<div class=\"sound-player-container\">",
      "\t<audio preload=\"none\" src=\"${1:sound.mp3}\"></audio>",
      "\t<div class=\"sound-player-poster\">",
      "\t\t<img src=\"${2:cover.jpg}\" alt=\"${3:Album Cover}\" />",
      "\t</div>",
      "\t<div class=\"sound-player-controls\">",
      "\t\t<h2 class=\"sound-player-title\">${4:Track Title}</h2>",
      "\t\t<h3 class=\"sound-player-artist-name\">${5:Artist Name}</h3>",
      "\t\t<div class=\"d-flex justify-content-center gap-1\">",
      "\t\t\t<button class=\"sound-player-prev-btn\"><i class=\"fa-solid fa-backward-step\"></i></button>",
      "\t\t\t<button class=\"sound-player-play-pause-btn\"><i class=\"fa-solid fa-play\"></i></button>",
      "\t\t\t<button class=\"sound-player-next-btn\"><i class=\"fa-solid fa-forward-step\"></i></button>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "Simple audio player markup"
  },
  "Simple Video Player (HTML)": {
    "prefix": [
      "video-player-simple",
      "video-player-html"
    ],
    "body": [
      "<div class=\"video-player-container\">",
      "\t<video preload=\"none\" poster=\"${1:poster.jpg}\" src=\"${2:video.mp4}\"></video>",
      "\t<div class=\"video-player-controls\">",
      "\t\t<div class=\"d-flex justify-content-center gap-1\">",
      "\t\t\t<button class=\"video-player-prev-btn\"><i class=\"fa-solid fa-backward-step\"></i></button>",
      "\t\t\t<button class=\"video-player-play-pause-btn\"><i class=\"fa-solid fa-play\"></i></button>",
      "\t\t\t<button class=\"video-player-next-btn\"><i class=\"fa-solid fa-forward-step\"></i></button>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "Simple video player markup"
  },
